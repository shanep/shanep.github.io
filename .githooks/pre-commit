#!/usr/bin/env bash
# Lints the Markdown files staged in this commit with the same rules CI uses
# (.markdownlint.jsonc). The full site build runs in pre-push.
set -euo pipefail

files=()
while IFS= read -r -d '' f; do
  case "$f" in
    docs/.vitepress/*) ;;
    docs/*.md | parts/*.md | shared/*.md) files+=("$f") ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

[ "${#files[@]}" -eq 0 ] && exit 0
exec npx --yes markdownlint-cli2 "${files[@]}"
