{
  "devDependencies": {
    "@types/markdown-it-container": "^4.0.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^24.19.1",
    "beasties": "^0.5.5",
    "image-size": "^2.0.4",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mathjax3": "^4.3.2",
    "sharp": "^0.35.5",
    "shiki": "^2.5.0",
    "vitepress": "^1.6.4"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --port 3000",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "git config core.hooksPath .githooks",
    "clean": "rm -rf node_modules docs/.vitepress/dist docs/.vitepress/cache",
    "cv:pdf": "scripts/cv/build.sh",
    "lint:md": "npx --yes markdownlint-cli2@0.23.3 \"docs/**/*.md\" \"parts/**/*.md\" \"shared/**/*.md\" \"#node_modules\" \"#docs/.vitepress\"",
    "a11y": "scripts/a11y/check.sh",
    "diagrams": "scripts/a11y/check.sh --diagrams",
    "diagrams:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/a11y/diagrams.mjs --export",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "a11y:pdf": "node scripts/a11y/pdf.mjs",
    "check": "npm run lint:md && npm run docs:build && npm run lighthouse"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "reveal.js": "^6.0.1"
  },
  "overrides": {
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=24"
  }
}
